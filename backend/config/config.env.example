# ---------------------------------------------------------------------------
# Backend environment
#
# Loaded by server.js:24 -> dotenv.config({ path: "./config/config.env" })
# NOTE: the filename is config/config.env, NOT .env. A file named .env is
# never read. Copy this file to config/config.env and fill in real values.
#
# On Render/Railway you do NOT need this file: set these as dashboard env
# vars and dotenv will silently no-op when the file is absent.
# ---------------------------------------------------------------------------

# --- Required ---------------------------------------------------------------

# Postgres connection string. Neon: copy the pooled connection string.
# A bad value makes config/db.js:15 call process.exit(1), which presents as a
# restart loop rather than a readable error, so check this one first.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Secret used to sign session JWTs. Generate a fresh one per environment:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-me-with-a-generated-secret

# Google OAuth client ID. MUST be identical to the frontend's
# NEXT_PUBLIC_GOOGLE_CLIENT_ID: it is verified as the token audience at
# controllers/authController.js:37, and a mismatch fails every login.
GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com

# Exact origin of the frontend, no trailing slash. CORS at server.js:33 is an
# exact string match, so "https://foo.vercel.app/" will NOT match.
FRONTEND_ORIGIN=http://localhost:3000

# Must literally equal "production" in deployment. authController.js:13-18 only
# sets sameSite:'none' + secure:true under it, and cross-site cookies from
# Vercel to Render need both or the browser drops the session silently.
NODE_ENV=development

# --- Optional ---------------------------------------------------------------

# Port to bind. Render injects its own PORT; leave unset there. (server.js:75)
PORT=5000

# JWT lifetime. Defaults to 7d at authController.js:8 when unset.
JWT_EXPIRES_IN=7d

# Server URL shown in the Swagger UI at /api-docs. Falls back to
# API_BASE_URL, then http://localhost:5000 (docs/openapi.js:1-4).
# SWAGGER_SERVER_URL=https://your-api.onrender.com
# API_BASE_URL=https://your-api.onrender.com

# --- Leave this unset -------------------------------------------------------

# authController.js:18 passes this as the session cookie's Domain in
# production. The frontend (vercel.app) and API (onrender.com) are different
# registrable domains, so no single value covers both -- and a wrong value
# makes the browser drop the cookie with no error anywhere: login appears to
# succeed, then nothing is authenticated. Unset = defaults to the API's own
# host = correct. Only set this if both ends share one parent domain.
# COOKIE_DOMAIN=
