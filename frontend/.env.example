# ---------------------------------------------------------------------------
# Frontend environment
#
# Next.js loads .env.local automatically. Copy this file to .env.local and
# fill in real values.
#
# Every NEXT_PUBLIC_* value is inlined into the JS bundle at BUILD time, so
# changing one in the Vercel dashboard requires a redeploy to take effect.
# They are also publicly visible in the shipped bundle -- never put a secret
# in one.
# ---------------------------------------------------------------------------

# Backend origin. ORIGIN ONLY -- no trailing slash and no /api/v1, because
# call sites append it themselves (e.g. `${BASE}/api/v1/posts`).
#
# These two are the SAME value. They were never consolidated: 36 references
# use the first, 6 use the second. Setting only one leaves those six files
# fetching "undefined/api/v1/..." at runtime.
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_BACKEND_URL=http://localhost:5000

# Google OAuth client ID, read at components/auth/GoogleSignInButton.tsx:21
# and :44. MUST equal the backend's GOOGLE_CLIENT_ID -- it is checked as the
# token audience, so a mismatch fails every login. The origin you deploy to
# must also be listed in that client's authorized JavaScript origins.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com

# Set to "1" to serve mock data instead of calling the API. Any other value
# (or unset) means live. Used by hooks/useCurrentUser.ts:44,
# hooks/useUserProfile.ts:79, hooks/userPostComments.ts:77.
NEXT_PUBLIC_USE_MOCK=0

# --- Not wired up yet -------------------------------------------------------
#
# Cloudinary is currently HARDCODED in four files rather than read from the
# environment, across two different accounts:
#   utils/uploadImage.ts:3-4          dkhggwcub / unsigned_preset
#   components/post/CreatePostModal.tsx:29-30   dkhggwcub / unsigned_preset
#   components/comment/CreateComment.tsx:2-3    dvlsunwrx / Shiba_comment_image
#   components/comment/CommentEditor.tsx:10-11  dvlsunwrx / Shiba_comment_image
#
# Defining the two variables below has NO effect until that code is changed to
# read them. Uploads go browser-direct, so the preset must be UNSIGNED.
# NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
# NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
